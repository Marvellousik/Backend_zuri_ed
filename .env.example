# ==============================================================================
# ZURI PLATFORM — ROOT ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# Copy this file to .env and populate secrets.
# NEVER commit real credentials to version control.
# ==============================================================================

# --- Global Service Configuration ---
ENVIRONMENT=development
LOG_LEVEL=info
PORT=8080
ALLOWED_ORIGINS=http://localhost:3000,https://app.zuri.app

# --- Databases & Cache ---
DATABASE_URL=postgresql://zuri:zuri_secret@localhost:5432/zuri?sslmode=disable
REDIS_URL=localhost:6379

# --- Security & Authentication ---
PRIVATE_KEY_ENCRYPTION_KEY=your-secure-master-key-min-32-chars-long
BCRYPT_COST=12
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=720h
JWT_SECRET=your-jwt-secret-key-here
INTERNAL_API_KEY=dev-internal-key

# --- Gateway & Traffic Control ---
RATE_LIMIT_RPM=100
AI_RATE_LIMIT_RPM=20
AI_DAILY_QUOTA=50
CIRCUIT_BREAKER_THRESHOLD=3
CIRCUIT_BREAKER_TIMEOUT=60s

# --- Local Microservice Routing (Local Host Ports) ---
USER_SERVICE_URL=http://localhost:8081
CONTENT_SERVICE_URL=http://localhost:8082
ANALYTICS_SERVICE_URL=http://localhost:8083
NOTIFICATION_SERVICE_URL=http://localhost:8084
SYNC_SERVICE_URL=http://localhost:8085
ACADEMIC_SERVICE_URL=http://localhost:8086
AI_SERVICE_URL=http://localhost:5005
AI_SERVICE_TIMEOUT=120s

# --- MinIO S3-Compatible Object Storage ---
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin_secret
MINIO_BUCKET=zuri-materials
MINIO_PUBLIC_URL=

# --- AI & LLM Provider API Keys ---
GEMINI_API_KEY=
COHERE_API_KEY=
OPENROUTER_API_KEY=

# --- Email Notifications (SMTP - Optional) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=notifications@zuri.app

# --- Push Notifications (FCM / Firebase - Optional) ---
FIREBASE_SERVICE_ACCOUNT_PATH=
